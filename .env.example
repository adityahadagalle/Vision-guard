# ==============================================================================
# VisionGuard Local Configuration Example
#
# IMPORTANT:
# - This file contains non-sensitive configuration defaults only.
# - NEVER put private keys, passwords, or production secrets in this file.
# - Copy this file to '.env' for local custom overrides.
# ==============================================================================

# Application Environment
VISIONGUARD_ENV=development
VISIONGUARD_HOST=127.0.0.1
VISIONGUARD_PORT=8000
VISIONGUARD_LOG_LEVEL=INFO

# Storage & Persistence
VISIONGUARD_DATA_DIR=./data
VISIONGUARD_DATABASE_URL=sqlite:///./data/visionguard.db

# Processing Constraints & Guardrails
VISIONGUARD_MAX_UPLOAD_MB=250
VISIONGUARD_MAX_IMAGE_PIXELS=40000000

# Offline Mode Enforcement (no external network calls permitted at runtime)
VISIONGUARD_OFFLINE_MODE=true
